const int redPin = 9;
const int greenPin = 8;
const int bluePin = 7;

void setup() {
  // Initialize serial and wait for port to open:
  Serial.begin(9600);
  // This delay gives the chance to wait for a Serial Monitor without blocking if none is found
  delay(1500); 

  // Defined in thingProperties.h
  initProperties();

  // Connect to Arduino IoT Cloud
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  
  /*
     The following function allows you to obtain more information
     related to the state of network and IoT Cloud connection and errors
     the higher number the more granular information you’ll get.
     The default is 0 (only errors).
     Maximum is 4
 */
  setDebugMessageLevel(3);
  ArduinoCloud.printDebugInfo();

  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);
}

void loop() {
  ArduinoCloud.update();
  // Your code here 
  
  
}

/*
  Since ButtonMatrixState is READ_WRITE variable, onButtonMatrixStateChange() is
  executed every time a new value is received from IoT Cloud.
*/
void onButtonMatrixStateChange()  {
  // Add your code here to act upon ButtonMatrixState change
  Serial.print("New state: ");
  Serial.println(button_matrix_state);

  if (button_matrix_state == "LOCKED") {
    //blå
    analogWrite(redPin, 0);
    analogWrite(greenPin, 0);
    analogWrite(bluePin, 10);

  } else if (button_matrix_state == "UNLOCKED") {
    //grön
    analogWrite(redPin, 0);
    analogWrite(greenPin, 10);
    analogWrite(bluePin, 0);

  } else if (button_matrix_state == "ERROR") {
    //röd
    analogWrite(redPin, 10);
    analogWrite(greenPin, 0);
    analogWrite(bluePin, 0);

  } else {
    analogWrite(redPin, 0);
    analogWrite(greenPin, 0);
    analogWrite(bluePin, 0);
  }
}

